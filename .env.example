# Copy this file to .env and set the values for your OpenAI-compatible server.
ASTRIX_LLM_BASE_URL=http://localhost:8000/v1
ASTRIX_LLM_API_KEY=replace-with-your-local-key
ASTRIX_LLM_MODEL=your-model-name

# Optional: change the verification image (default: golang:1.27).
# ASTRIX_SANDBOX_IMAGE=golang:1.27

# Required by astrixd. Set this in the service environment, not in a committed file.
# ASTRIX_WEBHOOK_SECRET=replace-with-a-long-random-secret
